# Example only: export these variables in your shell or configure Render ENV.
# This application does not automatically load .env files. For local work, pass a
# copy explicitly: "uvicorn ... --env-file .env" and "python -m api.manage --env-file .env".
# Plain KEY=VALUE lines: no quotes, no "export", no inline comments.
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
# Production: exact HTTPS Vercel origins separated by commas, no trailing slash.
# APP_ENV=production
# CORS_ORIGINS=https://your-project.vercel.app,https://your-approved-preview.vercel.app
# PROMETHEUS_DATASET_PATH=/etc/secrets/descriptors.json
# Google Earth Engine: credentials stay ONLY in Render Secret Files.
GEE_ENABLED=false
# GEE_PROJECT_ID=your-registered-google-cloud-project
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/earth-engine-service-account.json
# PROMETHEUS_TARGETS_PATH=/etc/secrets/planetary-targets.json
# Accounts (docs/ACCOUNTS.md). Without DATABASE_URL every /auth and /users route answers
# 503 auth_not_configured; the analysis API keeps working. Use the pooled Neon URL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require
# First administrator: created at startup only while no admin exists (8 to 128 characters).
# ADMIN_EMAIL=admin@example.org
# ADMIN_PASSWORD=replace-with-a-long-random-password
# SESSION_HOURS=12
# TEMPORARY_PASSWORD_DAYS=7
# Copilot (Gemini, Google AI Studio). Without the key, POST /api/v1/assistant/ask answers 503
# assistant_not_configured and everything else keeps working. The key never reaches the browser.
# GEMINI_API_KEY=your-google-ai-studio-key
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# ASSISTANT_HOURLY_LIMIT=40
