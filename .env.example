# Example only: export these variables in your shell or configure Render ENV.
# This application does not automatically load .env files.
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
# Production: exact HTTPS Vercel origins separated by commas, no trailing slash.
# APP_ENV=production
# CORS_ORIGINS=https://your-project.vercel.app,https://your-approved-preview.vercel.app
# PROMETHEUS_DATASET_PATH=/etc/secrets/descriptors.json
# Google Earth Engine: credentials stay ONLY in Render Secret Files.
GEE_ENABLED=false
# GEE_PROJECT_ID=your-registered-google-cloud-project
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/earth-engine-service-account.json
# PROMETHEUS_TARGETS_PATH=/etc/secrets/planetary-targets.json
